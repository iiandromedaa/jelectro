<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="0.0" minWidth="0.0" prefWidth="255.0" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox prefWidth="255.0" spacing="10.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="10.0">
               <children>
                  <Label text="X Position (m)" />
                  <Spinner editable="true" prefHeight="26.0" prefWidth="100.0" fx:id="xpos" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" layoutX="20.0" layoutY="20.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <Label text="Y Position (m)" />
                  <Spinner fx:id="ypos" editable="true" prefHeight="26.0" prefWidth="100.0" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" layoutX="20.0" layoutY="56.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <Label text="Z Position (m)" />
                  <Spinner fx:id="zpos" editable="true" prefHeight="26.0" prefWidth="100.0" />
               </children>
            </HBox>
            <Separator prefWidth="200.0" />
            <HBox alignment="CENTER_LEFT" layoutX="20.0" layoutY="20.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <Label text="X Rotation (deg)" />
                  <Spinner editable="true" prefHeight="26.0" prefWidth="100.0" fx:id="xrot" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" layoutX="20.0" layoutY="56.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <Label text="Y Rotation (deg)" />
                  <Spinner fx:id="yrot" editable="true" prefHeight="26.0" prefWidth="100.0" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" layoutX="20.0" layoutY="92.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <Label text="Z Rotation (deg)" />
                  <Spinner fx:id="zrot" editable="true" prefHeight="26.0" prefWidth="100.0" />
               </children>
            </HBox>
            <Separator prefWidth="200.0" />
            <Label text="Velocity (XYZ) (m/s)" />
            <HBox spacing="10.0">
               <children>
                  <Spinner fx:id="vx" editable="true" />
                  <Spinner fx:id="vy" editable="true" />
                  <Spinner fx:id="vz" editable="true" />
               </children>
            </HBox>
            <Separator prefWidth="200.0" />
            <HBox alignment="CENTER_LEFT" layoutX="20.0" layoutY="213.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <Label text="Charge (nC)" />
                  <Spinner fx:id="charge" editable="true" prefHeight="26.0" prefWidth="100.0" />
               </children>
            </HBox>
            <Label text="(Charge of point charges in multipole case)" textOverrun="CLIP" wrapText="true">
               <font>
                  <Font size="11.0" />
               </font>
            </Label>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
